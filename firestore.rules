rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Profil: tylko właściciel czyta; wallet/plan/noAdsUntil zapis wyłącznie
    // przez Cloud Functions (klient nie może podbić sobie PRO ani salda).
    // Create rozdzielony od update — przy create resource.data nie istnieje.
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.plan == 'free'
        && !('wallet' in request.resource.data)
        && !('noAdsUntil' in request.resource.data)
        && !('usage' in request.resource.data);
      allow update: if signedIn()
        && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['plan', 'wallet', 'noAdsUntil', 'usage', 'subscription', 'paddleCustomerId', 'paddleCustomerEmail']);
      allow delete: if false;
    }

    // Wyszukiwanie użytkowników po nicku/e-mailu wymaga publicznego odczytu
    // minimalnych pól — ograniczone do zalogowanych.
    match /usersPublic/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // Znajomości: uczestnik czyta i tworzy; zmiana statusu tylko uczestnik;
    // usuwa ten, do którego zaproszenie NIE zostało jeszcze przyjęte lub obaj.
    match /friendships/{id} {
      allow read, create: if signedIn()
        && request.auth.uid in [request.resource.data.uidA, request.resource.data.uidB];
      allow update: if signedIn() && request.auth.uid in [resource.data.uidA, resource.data.uidB]
        && request.resource.data.uidA == resource.data.uidA
        && request.resource.data.uidB == resource.data.uidB;
      allow delete: if signedIn() && request.auth.uid in [resource.data.uidA, resource.data.uidB];
    }

    // Czaty: tylko członkowie.
    match /chats/{chatId} {
      allow read, update: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members;
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
          && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Konfiguracja aplikacji (auto-update + modele TTS Pro): publiczny ODCZYT,
    // brak zapisu (tylko przez Firebase Console / admin SDK / webapp admina).
    // App czyta te dokumenty PRZED logowaniem (auto-update), więc read:true.
    match /app_config/{doc} {
      allow read: if true;
      allow write: if false;
    }
  }
}
