<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Self-update: install APK downloaded from mini.verbigem.com (unknown source). -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Kontakty: opcjonalne wyszukiwanie znajomych. Prosimy o nie DOPIERO po
         ekranie prominent disclosure (ContactsPermissionScreen) — wymóg Google
         Play. Numery nie opuszczają urządzenia (patrz polityka prywatności). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Android 13+ requires this at runtime, not just install time. The prompt is
         shown once, when the user first opens the chat inbox — asking on a cold start
         (before they have ever sent a message) is the classic way to get "Deny". -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <!-- Vulkan GPU — optional, CPU fallback works without it -->
    <uses-feature
        android:name="android.hardware.vulkan.level"
        android:version="0"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.vulkan.compute"
        android:version="0"
        android:required="false" />

    <application
        android:name=".VerbigemApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VerbigemAndroid">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VerbigemAndroid"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- App Links do profilu (Faza 4.3): `mini.verbigem.com/u/<uid>` otwiera
                 od razu kartę kontaktu w aplikacji. `autoVerify=true` każe systemowi
                 sprawdzić assetlinks.json przy instalacji — plik leży w
                 mini/dist/.well-known/assetlinks.json (hosting `mini`). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="mini.verbigem.com"
                    android:pathPrefix="/u/" />
            </intent-filter>
        </activity>

        <!-- FCM. `exported="false"`: only the system (Google Play services) may
             deliver to it, and it carries no intent-filter, so nothing else can. -->
        <service
            android:name=".notifications.VerbigemMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Handles "Reply" and "Mark as read" from a chat notification. -->
        <receiver
            android:name=".notifications.NotificationActionReceiver"
            android:exported="false" />

        <!-- Exposes downloaded APK to the package installer via content:// URI. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
