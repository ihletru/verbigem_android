<?xml version="1.0" encoding="utf-8"?>
<!--
  Foreground warstwy adaptive icon. Wskazuje na ic_launcher_firefly.png przez
  <inset>, żeby logo trafiło do centralnych ~60% (safe zone 66dp/108dp). Tło
  (CalmDayBg #F7F5F1 z ic_launcher_background.xml) widać w przezroczystych
  miejscach PNG i w 20% marginesie.
-->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_launcher_firefly"
    android:inset="20%" />