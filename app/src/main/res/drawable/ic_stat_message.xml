<!--
  Status-bar icon for chat push notifications.

  From Android 5.0 the system tints notification small icons with a single colour
  (white in the shade), so any fill colour here is ignored — only the ALPHA
  matters. That is why this is a plain silhouette with no brand colour.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="?attr/colorControlNormal">
    <path
        android:fillColor="@android:color/white"
        android:pathData="M20,2H4C2.9,2 2,2.9 2,4v22l4,-4h14c1.1,0 2,-0.9 2,-2V4C22,2.9 21.1,2 20,2z" />
</vector>
