    <string name="attach_image">附加照片</string>
    <string name="photo">照片</string>
    <string name="ocr_text">照片中的文字</string>
    <string name="voice_message">语音消息</string>
    <string name="record_voice">录音</string>
    <string name="voice_listening">正在聆听…</string>
    <string name="voice_stop">停止</string>
